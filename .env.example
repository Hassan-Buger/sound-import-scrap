# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://scraper:scraper_pass@localhost:5432/soundimports

# Database (SQLite alternative — comment out PostgreSQL and uncomment this)
# DATABASE_URL=sqlite+aiosqlite:///./soundimports.db

# Scraper reliability (SCRAPER_* names are preferred; legacy short names work)
BASE_URL=https://www.soundimports.eu
SITEMAP_URL=https://www.soundimports.eu/en/sitemap/
SCRAPER_CONCURRENCY=20
SCRAPER_CATEGORY_CONCURRENCY=5
SCRAPER_PRODUCT_CONCURRENCY=20
SCRAPER_REQUEST_DELAY=0.1
SCRAPER_RATE_LIMIT=0
SCRAPER_MAX_RETRIES=5
SCRAPER_CATEGORY_RETRIES=3
SCRAPER_TIMEOUT=30
SCRAPER_CATEGORY_DEACTIVATION_THRESHOLD=2
SCRAPER_JOB_STALE_AFTER=120
USER_AGENT=Mozilla/5.0 (compatible; SoundImportsScraper/1.0)

# API
API_HOST=0.0.0.0
API_PORT=8000

# JSON export directory (for debugging)
JSON_EXPORT_DIR=export

# Logging
LOG_LEVEL=INFO
